#!/bin/sh
# Show the OOBE on installed systems only. On the live ISO the installer is the
# setup path. Both markers are checked: the OOBE writes the user marker, and the
# privileged helper writes the system marker before first-boot autologin is
# removed. This prevents setup from ever running twice.
set -eu

if [ -d /run/live ] || [ -d /cdrom/casper ] \
    || grep -qw 'boot=casper' /proc/cmdline 2>/dev/null; then
    exit 0
fi

marker="${XDG_CONFIG_HOME:-$HOME/.config}/aurelia-setup-complete"
if [ -f "$marker" ] || [ -f /var/lib/aurelia/oobe-complete ]; then
    exit 0
fi

exec /usr/bin/aurelia-setup
