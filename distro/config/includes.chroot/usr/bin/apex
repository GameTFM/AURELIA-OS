#!/bin/sh
# Apex launcher. The Python application lives in the system data directory
# so distribution packaging and static validation can inspect the real source.
set -eu

# Qt WebEngine needs a usable graphics context. On machines without a DRM
# render node (VMs, some remote sessions) Qt reports
#   libEGL warning: egl: failed to create dri2 screen
# so the launcher selects a real software path. A machine with a render node
# keeps hardware acceleration untouched.
if [ ! -e /dev/dri/renderD128 ]; then
    export LIBGL_ALWAYS_SOFTWARE=1
    export QT_QUICK_BACKEND=software
    export QT_OPENGL=software
    export QTWEBENGINE_CHROMIUM_FLAGS="${QTWEBENGINE_CHROMIUM_FLAGS:---disable-gpu --enable-unsafe-swiftshader --disable-dev-shm-usage}"

    # XWayland is a valid alternative only when the session actually exported a
    # display, its authority file is readable, and Qt's xcb-cursor dependency is
    # installed. Measured: with any one missing, the xcb plugin aborts with
    # "could not connect to display" or "xcb-cursor0 ... is needed" and Apex
    # never reaches a window. Without all three, stay on the Wayland platform,
    # which keeps the process and its window construction alive.
    if [ -n "${DISPLAY:-}" ] && [ -n "${XAUTHORITY:-}" ] && [ -r "${XAUTHORITY}" ] \
        && ldconfig -p 2>/dev/null | grep -q 'libxcb-cursor\.so\.0'; then
        export QT_QPA_PLATFORM=xcb
    fi
fi

exec python3 /usr/share/apex/apex.py "$@"
