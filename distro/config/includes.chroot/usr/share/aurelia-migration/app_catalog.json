{
  "version": 1,
  "apps": [
    {"match": ["google chrome", "chrome"], "linux": {"type": "apt", "package": "chromium", "label": "Chromium"}, "alternative": "Chromium", "note": "Chrome profile bookmarks and history can also be imported into NOVAIR."},
    {"match": ["microsoft edge", "edge"], "linux": {"type": "apt", "package": "chromium", "label": "Chromium"}, "alternative": "Chromium", "note": "Edge data is imported into NOVAIR where supported."},
    {"match": ["mozilla firefox", "firefox"], "linux": {"type": "flatpak", "id": "org.mozilla.firefox", "label": "Mozilla Firefox"}, "alternative": "Mozilla Firefox (Flathub)"},
    {"match": ["mozilla thunderbird", "thunderbird"], "linux": {"type": "flatpak", "id": "org.mozilla.Thunderbird", "label": "Thunderbird"}, "alternative": "Thunderbird (Flathub)"},
    {"match": ["vlc media player", "vlc"], "linux": {"type": "apt", "package": "vlc", "label": "VLC media player"}},
    {"match": ["7-zip", "7zip"], "linux": {"type": "apt", "package": "7zip", "label": "7-Zip"}},
    {"match": ["libreoffice"], "linux": {"type": "apt", "package": "libreoffice", "label": "LibreOffice"}},
    {"match": ["gimp"], "linux": {"type": "apt", "package": "gimp", "label": "GIMP"}},
    {"match": ["inkscape"], "linux": {"type": "apt", "package": "inkscape", "label": "Inkscape"}},
    {"match": ["audacity"], "linux": {"type": "apt", "package": "audacity", "label": "Audacity"}},
    {"match": ["krita"], "linux": {"type": "apt", "package": "krita", "label": "Krita"}},
    {"match": ["filezilla"], "linux": {"type": "apt", "package": "filezilla", "label": "FileZilla"}},
    {"match": ["remmina"], "linux": {"type": "apt", "package": "remmina", "label": "Remmina"}},
    {"match": ["keepassxc", "keepass"], "linux": {"type": "apt", "package": "keepassxc", "label": "KeePassXC"}},
    {"match": ["obs studio", "obs"], "linux": {"type": "apt", "package": "obs-studio", "label": "OBS Studio"}},
    {"match": ["qbittorrent"], "linux": {"type": "apt", "package": "qbittorrent", "label": "qBittorrent"}},
    {"match": ["telegram"], "linux": {"type": "apt", "package": "telegram-desktop", "label": "Telegram Desktop"}},
    {"match": ["signal"], "linux": {"type": "flatpak", "id": "org.signal.Signal", "label": "Signal"}, "alternative": "Signal (Flathub)"},
    {"match": ["discord"], "linux": {"type": "flatpak", "id": "com.discordapp.Discord", "label": "Discord"}, "alternative": "Discord (Flathub)"},
    {"match": ["spotify"], "linux": {"type": "flatpak", "id": "com.spotify.Client", "label": "Spotify"}, "alternative": "Spotify (Flathub)"},
    {"match": ["steam"], "linux": {"type": "apt", "package": "steam", "label": "Steam"}},
    {"match": ["visual studio code", "vscode"], "linux": {"type": "flatpak", "id": "com.visualstudio.code", "label": "Visual Studio Code"}, "alternative": "VS Code (Flathub)"},
    {"match": ["zoom"], "linux": {"type": "flatpak", "id": "us.zoom.Zoom", "label": "Zoom"}, "alternative": "Zoom (Flathub)"},
    {"match": ["slack"], "linux": {"type": "flatpak", "id": "com.slack.Slack", "label": "Slack"}, "alternative": "Slack (Flathub)"},
    {"match": ["notepad++", "notepad plus"], "linux": {"type": "apt", "package": "kate", "label": "Kate"}, "alternative": "Kate", "note": "Notepad++ itself is a Windows application; Kate is the native editor."},
    {"match": ["microsoft office", "word", "excel", "powerpoint"], "alternative": "LibreOffice", "note": "Microsoft Office is not installable natively. LibreOffice opens common Office formats."},
    {"match": ["adobe photoshop", "photoshop"], "alternative": "GIMP or Krita", "note": "Photoshop is not installable natively. PSD support is available through GIMP/Krita."},
    {"match": ["itunes"], "alternative": "Elisa", "note": "iTunes is not installable natively; music files can be migrated."},
    {"match": ["windows media player"], "linux": {"type": "apt", "package": "vlc", "label": "VLC media player"}, "alternative": "VLC"},
    {"match": ["putty"], "linux": {"type": "apt", "package": "konsole", "label": "Konsole"}, "alternative": "Konsole + OpenSSH", "note": "SSH is provided by the system OpenSSH client."}
  ]
}
