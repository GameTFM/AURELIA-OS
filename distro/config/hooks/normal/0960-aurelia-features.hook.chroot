#!/bin/sh
# AURELIA migration, backup, OOBE and boot services.
set -eu
export DEBIAN_FRONTEND=noninteractive

for executable in \
    /usr/bin/aurelia-setup \
    /usr/bin/aurelia-migration \
    /usr/bin/aurelia-backup \
    /usr/share/aurelia-setup/aurelia-setup.py \
    /usr/share/aurelia-migration/aurelia_migration.py \
    /usr/share/aurelia-migration/aurelia-migration.py \
    /usr/share/aurelia-backup/aurelia_backup.py \
    /usr/share/aurelia-backup/aurelia-backup.py \
    /usr/libexec/aurelia/aurelia-setup-first-run \
    /usr/libexec/aurelia/aurelia-first-login \
    /usr/libexec/aurelia/aurelia-oobe-apply \
    /usr/libexec/aurelia/aurelia-firstboot-check \
    /usr/libexec/aurelia/aurelia-boot-guard \
    /usr/libexec/aurelia/aurelia-recovery \
    /usr/libexec/aurelia/aurelia-update-guard \
    /etc/grub.d/41_aurelia_recovery; do
    [ -f "$executable" ] && chmod 0755 "$executable"
done

# The payload is copied from a Windows build tree, where these files arrive mode
# 0777. systemd warns about executable, world-writable unit files and a writable
# unit is a local root escalation path, so the mode is normalised here.
chmod 0644 /etc/systemd/system/aurelia-*.service
chmod 0644 /etc/systemd/system/sddm.service.d/*.conf 2>/dev/null || true

if command -v systemctl >/dev/null 2>&1; then
    systemctl enable aurelia-firstboot.service
    systemctl enable aurelia-boot-guard.service
    systemctl enable aurelia-boot-success.service
    systemctl enable aurelia-recovery.service
fi

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme aurelia >/dev/null 2>&1 || true
fi

update-desktop-database /usr/share/applications || true
echo "AURELIA: migration, backup, OOBE and recovery services installed."
