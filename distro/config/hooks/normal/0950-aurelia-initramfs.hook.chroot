#!/bin/sh
# AURELIA: the live session mounts /casper/filesystem.squashfs and builds an
# overlay cow on top of it.  casper aborts with
#   /cow format specified as 'overlay' and no support found
# when overlayfs is not available, so build the initramfs late and verify it.
# squashfs and loop are built into this kernel; only overlayfs is a module.
set -eu

KVER="$(ls -1 /lib/modules | sort -V | tail -n 1)"
[ -n "$KVER" ] || { echo "AURELIA: no kernel modules found" >&2; exit 1; }

overlay="kernel/fs/overlayfs/overlay.ko"
if [ ! -e "/lib/modules/$KVER/$overlay" ] && [ ! -e "/lib/modules/$KVER/$overlay.zst" ]; then
    echo "AURELIA: $overlay missing for $KVER" >&2
    exit 1
fi

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme aurelia >/dev/null 2>&1 || true
fi

cat > /etc/initramfs-tools/modules <<'EOF'
overlay
loop
isofs
sr_mod
cdrom
EOF

# casper hardcodes BUILD_SYSTEM=Custom, so /scripts/casper-helpers leaves
# MP_QUIET empty and /scripts/casper runs
#   modprobe "" -b overlay
# modprobe reads the empty string as the module name, fails, and panics every
# live boot with "/cow format specified as 'overlay' and no support found".
# Mark this image as Ubuntu-based and drop the quoting so an empty value can
# never become a module argument again.
for f in /usr/share/initramfs-tools/scripts/casper /usr/share/initramfs-tools/scripts/casper-helpers; do
    [ -f "$f" ] || continue
    sed -i 's|BUILD_SYSTEM=Custom|BUILD_SYSTEM=Ubuntu|' "$f"
    sed -i 's|modprobe "${MP_QUIET}" -b overlay|modprobe ${MP_QUIET} -b overlay|' "$f"
done

update-initramfs -u -k all

for initrd in /boot/initrd.img-*; do
    lsinitramfs "$initrd" | grep -q 'overlayfs/overlay.ko' || {
        echo "AURELIA: $initrd does not contain overlayfs" >&2
        exit 1
    }
done

# live-build's chroot_hacks step regenerates /boot/initrd.img after the hooks
# and, with MODULES=dep, leaves every kernel module out. Keep a copy of this
# verified initramfs so the ISO builder can put it at /casper/initrd.img.
mkdir -p /var/tmp
cp -f "$initrd" /etc/aurelia-live-initrd.img
echo "AURELIA: stashed live initramfs at /etc/aurelia-live-initrd.img"

grep -q 'modprobe ${MP_QUIET} -b overlay' /usr/share/initramfs-tools/scripts/casper || {
    echo "AURELIA: casper modprobe quoting was not patched" >&2
    exit 1
}

echo "AURELIA: live initramfs contains overlayfs for $KVER"
