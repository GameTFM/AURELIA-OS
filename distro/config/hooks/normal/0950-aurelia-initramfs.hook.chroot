#!/bin/sh
# AURELIA: the live session mounts /casper/filesystem.squashfs and builds an
# overlay cow on top of it.  casper aborts with
#   /cow format specified as 'overlay' and no support found
# when overlayfs is not in the initramfs, so build it late and verify it.
# squashfs and loop are built into this kernel; only overlayfs is a module.
set -eu

KVER="$(ls -1 /lib/modules | sort -V | tail -n 1)"
[ -n "$KVER" ] || { echo "AURELIA: no kernel modules found" >&2; exit 1; }

overlay="kernel/fs/overlayfs/overlay.ko"
if [ ! -e "/lib/modules/$KVER/$overlay" ] && [ ! -e "/lib/modules/$KVER/$overlay.zst" ]; then
    echo "AURELIA: $overlay missing for $KVER" >&2
    exit 1
fi

cat > /etc/initramfs-tools/modules <<'EOF'
overlay
loop
isofs
sr_mod
cdrom
EOF

update-initramfs -u -k all

for initrd in /boot/initrd.img-*; do
    lsinitramfs "$initrd" | grep -q 'overlayfs/overlay.ko' || {
        echo "AURELIA: $initrd does not contain overlayfs" >&2
        exit 1
    }
done

echo "AURELIA: live initramfs contains overlayfs for $KVER"
